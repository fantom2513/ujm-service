APP_PORT=4173
APP_HOST=127.0.0.1
PUBLIC_APP_ORIGIN=http://127.0.0.1:4173
PRODUCT_HOME_URL=http://localhost:3000/

OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=

JIRA_BASE_URL=
JIRA_AUTH_TYPE=
JIRA_SERVICE_TOKEN=

CONFLUENCE_BASE_URL=
CONFLUENCE_AUTH_TYPE=
CONFLUENCE_SERVICE_TOKEN=

MAX_TEXT_FILE_MB=10
MAX_RECORDING_FILE_MB=100
MAX_CHAT_ATTACHMENT_MB=10
REQUEST_TIMEOUT_MS=120000

# LLM (vLLM / OpenAI-compatible)
LLM_URL=http://localhost:8000
LLM_MODEL=google/gemma-4
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_TEMPERATURE=0.1
LLM_SEED=
LLM_RESPONSE_FORMAT_MODE=json_schema
# Set to "true" only if LLM_URL's TLS cert is signed by an internal CA you
# can't supply to NODE_EXTRA_CA_CERTS. Disables cert validation for LLM calls only.
LLM_TLS_INSECURE=false
