APP_PORT=4173
APP_HOST=127.0.0.1
PUBLIC_APP_ORIGIN=http://127.0.0.1:4173
PRODUCT_HOME_URL=http://localhost:3000/

OPENAI_API_KEY=
OPENAI_GENERATION_MODEL=
OPENAI_CHAT_MODEL=
OPENAI_TRANSCRIPTION_MODEL=

# Kept for rollback to the previous TypeScript backend.
JIRA_BASE_URL=
JIRA_AUTH_TYPE=
JIRA_SERVICE_TOKEN=

CONFLUENCE_BASE_URL=
CONFLUENCE_AUTH_TYPE=
CONFLUENCE_SERVICE_TOKEN=

MAX_TEXT_FILE_MB=10
MAX_RECORDING_FILE_MB=100
MAX_CHAT_ATTACHMENT_MB=20
REQUEST_TIMEOUT_MS=120000

# LLM (vLLM / OpenAI-compatible)
LLM_URL=http://localhost:8000
LLM_MODEL=google/gemma-4
LLM_API_KEY=
LLM_TIMEOUT_MS=120000
LLM_DEADLINE_MS=120000
# Connect/pool budgets are phase limits inside the shared LLM deadline. A dead
# server or an exhausted client should fail fast instead of consuming the full
# logical-operation budget.
LLM_CONNECT_TIMEOUT_MS=5000
LLM_POOL_TIMEOUT_MS=5000
LLM_TEMPERATURE=0.1
LLM_SEED=
LLM_RESPONSE_FORMAT_MODE=json_schema
# Set to "true" only if LLM_URL's TLS cert is signed by an internal CA you
# can't supply to NODE_EXTRA_CA_CERTS. Disables cert validation for LLM calls only.
LLM_TLS_INSECURE=false

# Identity boundary (backend-py). The safe default ignores every client-supplied
# X-User-Id and treats requests as anonymous.
IDENTITY_MODE=anonymous
# trusted_header is not standalone production authentication. Enable it only
# behind a reverse proxy that authenticates users, removes any client-supplied
# X-User-Id, sets its own verified value, and prevents direct access to backend-py.

# PostgreSQL is private inside the Compose network; do not publish port 5432.
# Set a different strong POSTGRES_PASSWORD in ENV_TEST and ENV_PROD, then use
# the same value in DATABASE_URL. These example values are not production secrets.
POSTGRES_USER=uxarch
POSTGRES_PASSWORD=change-me
POSTGRES_DB=uxarch
DATABASE_URL=postgresql+asyncpg://uxarch:change-me@ux-architecture-postgres:5432/uxarch

# Redis is optional for the current backend-py request path. Keep the setting so
# it can point to an existing internal Redis when Redis-backed features are used.
REDIS_URL=redis://localhost:6379/2
REDIS_KEY_PREFIX=uxarch:

# Jira (backend-py) — real integration, Basic Auth via username + password.
JIRA_URL=
JIRA_USERNAME=
JIRA_PASSWORD=
# Set to "true" only if JIRA_URL's TLS cert is self-signed/internal-CA.
JIRA_TLS_INSECURE=false
